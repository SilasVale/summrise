#!/usr/bin/env bash
# main-only-by-merge — MAIN ADVANCES ONLY BY MERGE.
#
# MEASURED, 2026-09-26: `main` had ZERO merge commits in its last 300, so every commit was made directly on it — and red
# reached `main` three times (rounds 117, 128, 171), each time by a status that was thrown away one step after it was read.
# Nothing structural stood in the way. This is the structure.
#
# THE SERVER-SIDE HALF IS `scripts/test/main-shape-check.mjs`, AND IT IS NOT REDUNDANT. This script is fast, local, and
# `--no-verify` gets around it. The gate runs in CI and cannot be bypassed. It is also the only half that can see a plain
# `git merge` that FAST-FORWARDED — which creates NO commit at all, so this script never runs and `main` advances linearly
# carrying the branch's non-merge commits. Two instruments, because a rule with one enforcement point has one way around it.
#
# WHY IT IS ITS OWN FILE RATHER THAN A BLOCK INSIDE `pre-commit`, AND THIS WAS MEASURED THE HARD WAY: `pre-commit` exits 0
# on its fifth line unless `agent/scripts/panel-design-sweep.mjs` exists, because it is designed to be symlinked into a
# GLOBAL `core.hooksPath` and must be inert in every other repository the operator owns. A proof that copied the hook into a
# throwaway repository would therefore report green having run NOTHING. As its own script this rule can be tested on a real
# repository (`scripts/test/main-only-by-merge.bash`), and the wiring that calls it is asserted there too.
#
# AND IT IS CALLED *AFTER* THAT GUARD, DELIBERATELY. Placed before it, this rule would refuse commits on `main` in every
# other repository on this machine — which is precisely the outcome that guard exists to prevent.
#
# THE EXEMPTION IS THE MERGE ITSELF, not an environment variable: `git merge` runs the hook with `MERGE_HEAD` present, so
# the commit that lands reviewed work passes while the commit that bypasses the branch does not.
set -uo pipefail

branch=$(git branch --show-current 2>/dev/null || true)
if [ "$branch" != "main" ]; then
  exit 0
fi

if git rev-parse --verify -q MERGE_HEAD >/dev/null; then
  exit 0
fi

echo "pre-commit: this commit is being made directly on main." >&2
echo "  main advances only by merge. Open a branch, do the work there, then:  git merge --no-ff <branch>" >&2
echo "  (--no-ff matters: a plain merge fast-forwards when main has not moved and creates no commit at all," >&2
echo "   which this hook cannot see — scripts/test/main-shape-check.mjs in CI is the half that can.)" >&2
echo "  If you know this is right and want to bypass it anyway:  git commit --no-verify ..." >&2
exit 1
