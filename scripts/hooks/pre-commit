#!/usr/bin/env bash
# pre-commit — refuse a commit whose EMITTED scripts do not parse.
#
# WHY THIS EXISTS (round 225, REWRITTEN round 272). It used to guard a specific accident: each emitter built its
# payload inside a template literal, so a backtick anywhere in that text ended the literal early and the emitted file
# stopped parsing somewhere in the middle of 30 KB. THAT CLASS IS GONE — rounds 266-271 moved all five payloads into
# real modules assembled by `agent/scripts/lib/sweep-bundle.mjs`, which resolves the payload's own requires and
# COMPILES what it returns, so an emitter can no longer print something that does not parse.
#
# WHAT IT STILL BUYS: `--emit` is the only command that assembles every artifact end to end, and this runs all five in
# under a second — a payload module that does not parse, a relative require the assembler cannot resolve, an emitter
# that was renamed or deleted, or a pieces module that no longer evaluates all fail here rather than in the design job
# two minutes later. (The incident counts that used to be in this comment disagreed across three files — 34 here, 52
# in AGENTS.md, 38 in the operator's inbox. They are history; the ledger holds the incidents, and what this file needs
# is the RULE, not a number.)
#
# THE CHECK IS THE EMITTER'S OWN GUARANTEE, not a copy of it — which is what "the assembler compiles what it emits"
# means. A hook that costs time is a hook people bypass with --no-verify, so it stays five fast commands.
#
# IT CAUGHT ITS OWN STALENESS IN ROUND 243: the extension was removed and this loop still named its emitter, so the
# hook refused the very commit that removed it. That is the whole point of running the thing you guard.
#
# INSTALL (per clone, hooks are not versioned):
#     ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
set -uo pipefail

# FIND THIS HOOK'S OWN REPOSITORY — AND UNTIL 2026-09-26 THIS LINE FOUND THE WRONG ONE, WHICH MADE THE WHOLE FILE INERT.
#
# It used to be:   cd "$(dirname "$0")/../.." 2>/dev/null || cd "$(git rev-parse --show-toplevel)"
#
# `core.hooksPath` here is `.githooks`, so GIT INVOKES THIS AS `.githooks/pre-commit` and `$0` is that path — NOT the
# symlink's target. `dirname` is therefore `.githooks`, and `.githooks/../..` is **/home/zhengsaisi, one level ABOVE the
# repository**. The `cd` SUCCEEDED at the wrong place, so the `||` fallback never fired, the guard below found no
# `agent/scripts/panel-design-sweep.mjs`, and the hook exited 0 on its fifth line. MEASURED with the hook instrumented
# and a real `git commit`:
#
#     $0=.githooks/pre-commit   dirname=.githooks   pwd_before=/home/zhengsaisi/summrise
#     pwd_after=/home/zhengsaisi   guard_file_present=no
#
# **SO NOTHING THIS FILE CHECKS HAS RUN — not the emitters, not the archive-only rule, not the main-only-by-merge rule —
# for every commit since the hook was installed (round 118).** And the proof recorded for it in AGENTS.md ("proven by
# making an empty commit and watching it run") could not have caught it: an empty commit that SUCCEEDS looks exactly like
# a hook that ran and passed. The lesson is the one this repository keeps relearning — a check is only proven by watching
# it REFUSE something, never by watching a commit go through.
#
# `git rev-parse --show-toplevel` answers the real question ("which repository am I in?") instead of the proxy one ("what
# path was I invoked by?"), and it is correct in every repository — including the ones this hook must stay inert in, where
# the guard below then does its job. The `readlink -f` arm keeps it working outside a work tree.
HOOK_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || HOOK_ROOT=""
if [ -z "$HOOK_ROOT" ]; then
  HOOK_ROOT=$(cd "$(dirname "$(readlink -f "$0")")/../.." 2>/dev/null && pwd) || HOOK_ROOT=""
fi
[ -n "$HOOK_ROOT" ] || exit 0
cd "$HOOK_ROOT" || exit 0

# SAFE ANYWHERE, INCLUDING A SHARED HOOKS DIRECTORY. This file is designed to be symlinked into a global
# `core.hooksPath` (round 226), where it runs for EVERY repository the operator owns. Its first job is
# therefore to prove it is in the right one: if the emitters are not here, this is not Summrise, and a hook that
# blocked commits everywhere because it could not find a file would be a far worse outcome than the slips it
# exists to prevent. Exit 0 immediately.
if [ ! -f agent/scripts/panel-design-sweep.mjs ]; then
  # OBSERVABLE ON REQUEST, because this exit is the one that hid a completely inert hook for months. `SUMMRISE_HOOK_DEBUG=1`
  # makes it say so; without the variable it stays silent, since it fires in every OTHER repository on this machine and a
  # line of noise per commit there is its own defect. `scripts/test/hook-finds-its-repo.bash` is the caller that sets it.
  [ -n "${SUMMRISE_HOOK_DEBUG:-}" ] && echo "pre-commit: not the Summrise repo (cwd=$PWD, \$0=$0) — inert, nothing checked" >&2
  exit 0
fi

fail=0

# MAIN ADVANCES ONLY BY MERGE (spec 2026-09-26, landing 1). It lives in its own file, and it is called HERE — after the
# "is this Summrise?" guard above — for two measured reasons:
#
#   * the guard exits 0 in every other repository, so a rule placed BEFORE it would refuse commits on `main` across every
#     repository on this machine, which is exactly what that guard exists to prevent;
#   * a proof of a rule that lives below that guard cannot copy this hook into a throwaway repository and observe anything,
#     so the rule is its own script and `scripts/test/main-only-by-merge.bash` tests it there, on a real repository, in both
#     directions — and asserts this call site, because a rule nothing invokes does not exist.
if ! bash scripts/hooks/main-only-by-merge; then
  fail=1
fi

# A COMMIT THAT CHANGES ONLY AN ARCHIVE IS REFUSED (round 189; widened to all four archives in round 273). The archives record what
# a round CHANGED; when a commit changes nothing but an archive, the round produced no change for it to record, and the cheapest
# possible commit becomes the round's whole output. Measured before this rule existed: 18 of the last 30 commits touched
# docs/agents/design-ledger.md and NOTHING else — and nothing objected, ever.
#
# ROUND 273 WIDENED IT, AND CORRECTED THE SENTENCE THAT USED TO SIT HERE. It read "that file has no byte ceiling (457 KB) while its
# two sibling archives are capped at 400,000". THE FIRST HALF IS FALSE: the ceiling existed all along, and the check that applies it
# sat BELOW the only consumer of its result, so it could never fail — the gate printed `ok — … (457929 B of 400000)` and exited 0
# with the ledger 57,929 bytes over. The second half is no longer true either: every archive now carries a FLOOR and a CEILING, and
# there are four of them. Leaving the old one-file pattern would have made the NEW archive the new loophole, which is the same
# failure this rule exists to close, one file over.
#
# THE EXEMPTION IS DELIBERATE AND VISIBLE, not silent: a correction to a wrong archive entry is a real thing to commit, so set
#   SUMMRISE_LEDGER_ONLY=1 git commit ...
# The variable is the record that a human chose it; there is no marker file to leave behind by accident.
ARCHIVES='^docs/agents/(design-ledger|ledger-appendix|ledger-mutations|ledger-early-rounds)\.md$'
staged_only=$(git diff --cached --name-only 2>/dev/null | grep -v '^$' || true)
if [ -n "$staged_only" ] && [ "$(printf '%s\n' "$staged_only" | grep -vcE "$ARCHIVES")" = "0" ]; then
  if [ "$SUMMRISE_LEDGER_ONLY" != "1" ]; then
    echo "pre-commit: this commit changes ONLY ledger archives." >&2
    echo "  An archive records what a round changed; a round that changed nothing has nothing to record." >&2
    echo "  If this IS a correction to a wrong entry, say so deliberately:  SUMMRISE_LEDGER_ONLY=1 git commit ..." >&2
    fail=1
  fi
fi
# FIVE EMITTERS, AND NOW ALL FIVE ARE LISTED (round 272). The count in this comment has been wrong twice: it said four
# while the landing and the live probe were checked only by CI, then said six after an extension emitter that no longer
# exists was removed. The set is: panel, console, landing, the harness (`panel-render-audit.mjs`, whose success code in
# emit mode is 2) and `live-panel-probe.mjs` — the same five `panel-design-sweep.bash` proves use the assembler.
for f in panel console landing; do
  if ! node "agent/scripts/$f-design-sweep.mjs" --emit >/dev/null 2>/tmp/summrise-hook-$f.err; then
    echo "pre-commit: the $f sweep does not emit — $(tail -1 /tmp/summrise-hook-$f.err 2>/dev/null)" >&2
    fail=1
  fi
done

# The harness emitter's SUCCESS code in emit mode is 2 (it prints its usage and the path), which is why this
# one is not checked the same way — and the fixture gate asserts that distinction by name.
# NOT `if ! cmd; then rc=$?` — that form reports the NEGATED status, so a success code of 2 arrives as 1 and a
# failure as 0, which is how the first version of this hook passed a clean tree and failed nothing. The status
# is captured directly. (The same inversion is why the commit it was meant to refuse went through.)
node agent/scripts/panel-render-audit.mjs >/dev/null 2>/tmp/summrise-hook-audit.err; rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
  echo "pre-commit: the harness emitter exited $rc — $(tail -1 /tmp/summrise-hook-audit.err 2>/dev/null)" >&2
  fail=1
fi

# The live-panel probe emits a script for the device too, and its own guard throws on a bad parse.
if ! node agent/scripts/live-panel-probe.mjs --emit >/dev/null 2>/tmp/summrise-hook-live.err; then
  echo "pre-commit: the live-panel probe does not emit — $(tail -1 /tmp/summrise-hook-live.err 2>/dev/null)" >&2
  fail=1
fi

# The probe's own source is a template literal too, and its check is the one that knows.
if ! node scripts/test/contrast-probe-check.mjs >/dev/null 2>&1; then
  echo "pre-commit: the contrast probe's own check failed (see scripts/test/contrast-probe-check.mjs)" >&2
  fail=1
fi

if [ "$fail" != "0" ]; then
  echo "" >&2
  echo "pre-commit: refused — one or more checks above said no, and THE MESSAGE THAT NAMED THE REASON IS ABOVE THIS ONE." >&2
  echo "  This line used to blame the emitters unconditionally, which was true while they were the only check and became" >&2
  echo "  a lie the moment a second rule was added: measured 2026-09-26, the main-only-by-merge rule refused a commit and" >&2
  echo "  this text sent the reader to look at an emitter that was fine. A message that names the wrong cause is worse" >&2
  echo "  than none, because the reader believes it." >&2
  echo "  If the failure is unrelated to your change:  git commit --no-verify ...  and say so in the message." >&2
  exit 1
fi
