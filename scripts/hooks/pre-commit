#!/usr/bin/env bash
# pre-commit — refuse a commit whose EMITTED scripts do not parse.
#
# WHY THIS EXISTS (round 225). Five emitters in this repository build a standalone script for the device inside
# a template literal, and a backtick anywhere inside that literal ends it early — the emitted file then stops
# parsing somewhere in the middle of 30 KB. That has happened THIRTY-FOUR times in this project, and in the last
# six of them the failing check was already on screen: `emit=1`, and the commit made anyway. CI caught every one
# afterwards, which cost a red build each time.
#
# THE CHECK IS THE EMITTER'S OWN GUARD, not a copy of it: `--emit` compiles what it emits and exits non-zero
# when the result will not parse, so this hook cannot disagree with the thing it guards. It is fast — five
# emitters, well under a second each — because a hook that costs time is a hook people bypass with --no-verify.
#
# INSTALL (per clone, hooks are not versioned):
#     ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
set -uo pipefail
cd "$(dirname "$0")/../.." 2>/dev/null || cd "$(git rev-parse --show-toplevel)"

# SAFE ANYWHERE, INCLUDING A SHARED HOOKS DIRECTORY. This file is designed to be symlinked into a global
# `core.hooksPath` (round 226), where it runs for EVERY repository the operator owns. Its first job is
# therefore to prove it is in the right one: if the emitters are not here, this is not Vale, and a hook that
# blocked commits everywhere because it could not find a file would be a far worse outcome than the slips it
# exists to prevent. Exit 0 immediately.
if [ ! -f agent/scripts/panel-design-sweep.mjs ]; then
  exit 0
fi

fail=0
for f in panel console extension; do
  if ! node "agent/scripts/$f-design-sweep.mjs" --emit >/dev/null 2>/tmp/vale-hook-$f.err; then
    echo "pre-commit: the $f sweep does not emit — $(tail -1 /tmp/vale-hook-$f.err 2>/dev/null)" >&2
    fail=1
  fi
done

# The harness emitter's SUCCESS code in emit mode is 2 (it prints its usage and the path), which is why this
# one is not checked the same way — and the fixture gate asserts that distinction by name.
# NOT `if ! cmd; then rc=$?` — that form reports the NEGATED status, so a success code of 2 arrives as 1 and a
# failure as 0, which is how the first version of this hook passed a clean tree and failed nothing. The status
# is captured directly. (The same inversion is why the commit it was meant to refuse went through.)
node agent/scripts/panel-render-audit.mjs >/dev/null 2>/tmp/vale-hook-audit.err; rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
  echo "pre-commit: the harness emitter exited $rc — $(tail -1 /tmp/vale-hook-audit.err 2>/dev/null)" >&2
  fail=1
fi

# The probe's own source is a template literal too, and its check is the one that knows.
if ! node scripts/test/contrast-probe-check.mjs >/dev/null 2>&1; then
  echo "pre-commit: the contrast probe's own check failed (see scripts/test/contrast-probe-check.mjs)" >&2
  fail=1
fi

if [ "$fail" != "0" ]; then
  echo "" >&2
  echo "The emitted scripts are how the device runs every design check. Fix the emitter, then commit —" >&2
  echo "or use --no-verify if you know the failure is unrelated, and say so in the commit." >&2
  exit 1
fi
