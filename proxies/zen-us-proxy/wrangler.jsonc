{
  "name": "zen-us-proxy",
  // **THE ENTRY POINT IS THE RUST BUILD, AND THE JAVASCRIPT IS GONE (2026-10-08).**
  // `worker/verify.mjs` proved the port equal to `src/index.js` byte for byte — 17 cases, the upstream
  // requests included — and the JS was then deleted, with the comparison moved onto
  // `worker/shipping-answers.json`: the answers that same harness RECORDED on a run where both sides
  // agreed. **The oracle is a fixture now**, so this directory carries one implementation rather than
  // two, and the differential still fails if the port moves.
  "main": "worker/build/index.js",
  // **AND THE DEPLOY BUILDS IT, BECAUSE NOTHING ELSE DOES — MEASURED 2026-10-08.**
  // `worker/build/` is gitignored (its own `.gitignore` is `*`), so on a clean checkout the entry point
  // above does not exist, and `./scripts/build.sh proxies` runs `wrangler deploy` and nothing else.
  // Measured with the directory moved aside:
  //
  //     ✘ ERROR The entry-point file at "worker/build/index.js" was not found.
  //
  // CI only ever got away with it by ORDER: `scripts/test/rust-byte-checks.bash` runs `verify.mjs` earlier
  // in the same job, and that harness builds when `build/` is missing — a deploy that depends on a test
  // having run first is the same defect class as a check nobody runs. `gateway/wasm/wrangler.jsonc` carries
  // this key for the same reason; the crate here is one directory down, which is what the argument is for
  // (`worker-build`'s PATH is "the path to the Rust crate", and its output lands in `<crate>/build/`).
  "build": { "command": "worker-build --release worker" },
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  // 2026-08-26: custom_domains is ignored by wrangler 4 and was never bound
  // in the dashboard; the domain in practice returned 000.
  // Switched to an explicit zone route (when the API token has Workers Routes
  // write access, this field takes effect on deploy).
  "routes": [
    { "pattern": "zen-us.saisi.online/*", "zone_id": "79860b60a8681147d0ce38294d404ead" }
  ],
  // Explicit placement region (2026-01+ placement hints): pin execution to
  // the Cloudflare data center nearest us-east-1 (US east coast, e.g.
  // IAD/EWR), so egress to opencode zen leaves from a Meta-permitted US
  // region. smart placement was unusable here: it optimized toward
  // opencode.ai/zen/go and parked the worker in AMS (cf-placement:
  // local-AMS, observed 2026-09-07), and zen returned 403 RegionError for
  // muse-spark from that EU egress. Vercel (the previous muse exit) clears
  // the region check but caps request bodies at 4.5 MB (FUNCTION_
  // PAYLOAD_TOO_LARGE), which long muse contexts exceed — this worker has
  // no such body cap.
  "placement": { "region": "aws:us-east-1" },
  "d1_databases": [
    {
      // US-primary D1 (created with `wrangler d1 create zen-us-db-wnam
      // --location wnam`): pins compute to Western North America, so egress
      // to opencode zen leaves from a Meta-permitted region (clears the 403
      // RegionError the old EU-primary us-proxy-db produced) while keeping
      // the D1 geo-hack binding (never removed — see proxies/README.md).
      "binding": "DB",
      "database_name": "zen-us-db-wnam",
      "database_id": "c2ab3a58-7750-4782-936e-356b8f69747f"
    }
  ]
}
