{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summrise-dist",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  // Static assets served first (run_worker_first defaults to false), so
  // /summrise-agent/* release artifacts are served straight from ./public;
  // everything else hits the Worker. public/summrise-agent/ holds the npm-only
  // install channel (since 2026-08-28; the NSIS installer and its
  // setup.ps1/.exe assets are retired): versioned tgz + the
  // summrise-agent-latest.tgz alias, version.json (release discovery), icons
  // and fix-tunnel.ps1. NOTE: every asset must stay under the 25MiB
  // per-file Workers Assets limit.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Temporary file hosting: upload -> one-time download URL -> auto-deleted.
  // R2 bucket: `wrangler r2 bucket create summrise-temp-files`.
  // NOTE: no KV binding — one-time state lives on the R2 key + expiresAt
  // deadline, and the claim serializer moved to the relay worker with the rest of
  // the file relay (ADR 0010 D6).
  //
  // TEMP_FILES STAYS: this worker still serves the boxed components, and
  // /summrise-agent/summrise-playwright.zip streams out of this bucket. The relay
  // has its OWN bucket (summrise-relay-files) — sharing one would re-couple exactly
  // what the split exists to separate.
  "r2_buckets": [{ "binding": "TEMP_FILES", "bucket_name": "summrise-temp-files" }],
  // TempClaimDO is RETIRED here: its handlers (/api/upload, /files/<token>) belong to
  // `summrise-relay` now, and a class with no producer is dead weight in the one file a
  // reader consults to learn what this worker does. deleted_classes is the documented
  // way to remove one (the gateway did the same for PluginHubDO). The DO held NO
  // storage, so nothing is lost by the deletion.
  "migrations": [{ "tag": "v2-drop-temp-claim", "deleted_classes": ["TempClaimDO"] }],
  // Custom domain (added in the Cloudflare dashboard, like the other Summrise
  // workers — wrangler 4.x ignores the custom_domains field): <download-host>
  // Vars (set via `wrangler var put`, NOT committed): CONSOLE_URL (the Summrise
  // console URL rendered on the download page).
  "observability": { "enabled": false }
}
